# Shared backend environment variables
REPLICATE_API_KEY=
ELEVEN_API_KEY=
PORT=3000
NODE_ENV=production
API_BASE_URL=
CORS_ORIGIN=http://localhost:8080
TRUST_PROXY=false

# Replicate route configuration
REPLICATE_VIDEO_MODEL=
REPLICATE_VIDEO_VERSION=
REPLICATE_VIDEO_INPUT_TEMPLATE={"prompt":"{{prompt}}","duration":"{{duration}}"}

REPLICATE_IMAGE_MODEL=black-forest-labs/flux-schnell
REPLICATE_IMAGE_VERSION=
REPLICATE_IMAGE_INPUT_TEMPLATE={"prompt":"{{prompt}}","aspect_ratio":"16:9","output_format":"png"}

REPLICATE_PHOTO_TO_VIDEO_MODEL=
REPLICATE_PHOTO_TO_VIDEO_VERSION=
REPLICATE_PHOTO_TO_VIDEO_INPUT_TEMPLATE={"prompt":"{{prompt}}","input_image":"{{image}}","duration":"{{duration}}","allow_nsfw":"{{allowNsfw}}"}

# Optional ElevenLabs settings
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
